# RADAR environment configuration
#
# Copy to `.env` and fill in real values. NEVER commit a real client ID, Shared Drive ID or
# spreadsheet ID — `.gitignore` excludes `.env` and `.env.*` but allows this example file.
#
# Everything here is prefixed VITE_ and is therefore embedded in the browser bundle and
# publicly readable. That is acceptable for these values: none of them is a secret. They are
# identifiers, not credentials. RADAR holds no API key, no client secret and no
# service-account key — every Google call uses the signed-in user's own OAuth token, and
# access is enforced by Google against that user's Drive permissions.

# ── Required ────────────────────────────────────────────────────────────────────

# OAuth 2.0 Web application client ID (Google Cloud Console → APIs & Services → Credentials).
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# The one Shared Drive RADAR reads and writes. Every lookup and every creation is pinned to
# this drive; a client request can never retarget another one.
VITE_SHARED_DRIVE_ID=your-shared-drive-id-here

# ── Optional: Create structure workflow ─────────────────────────────────────────
#
# Both are used only by "Create structure". Leaving either unset does not break the feature:
# it degrades honestly and says so in the result screen.

# Master Registry spreadsheet (02_INVESTMENTS_AND_PROGRAMS/00_MASTER_INDEXES/00_Master_Registry).
# Columns are matched BY NAME from the header row, so column order does not matter, but these
# must exist: Object_Name, Theme, Object_Type, Official_Folder_Link.
# Unset → Registry updates are reported as PENDING_CONFIGURATION, never as written.
VITE_RADAR_REGISTRY_SHEET_ID=your-master-registry-spreadsheet-id-here

# Audit log spreadsheet. Must already exist with this exact header row, in this order:
#   Timestamp | Actor | Structure_Type | Inputs | Destination_Path | Plan_Hash | Operation_Id |
#   Outcome | Created_Items | Reused_Items | Registry_Result | Warnings | Failure_Stage | Error
# Unset → there is NO durable audit trail, and the UI says so explicitly.
VITE_RADAR_AUDIT_SHEET_ID=your-audit-log-spreadsheet-id-here
